{
  "name": "repo-stitcher",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-repo composition engine with AI-augmented stitching.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:deps": "depcruise packages/core/src --config packages/core/dependency-cruiser.config.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check:contracts": "bun scripts/contract-freeze.ts",
    "check:contracts:update": "bun scripts/contract-freeze.ts --update",
    "eval:schema": "bun scripts/emit-eval-schema.ts",
    "eval:schema:check": "bun scripts/emit-eval-schema.ts --check",
    "eval:verify-shas": "python eval/scripts/verify_shas.py",
    "build": "bun run build:core",
    "build:core": "cd packages/core && bun run build",
    "build:cli": "echo \"build:cli: deferred to P-062 (tsup)\" && exit 0",
    "build:web": "bun run --filter @repo-stitcher/web build",
    "build:all": "bun run build:core && bun run build:cli && bun run build:web",
    "dev:cli": "bun --watch packages/cli/src/index.ts",
    "mcp:server": "bun run --filter @repo-stitcher/mcp server",
    "dev:web": "bun run --filter @repo-stitcher/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "bun run typecheck && bun run lint && bun run test && bun run build",
    "prepare": "husky",
    "commitlint": "commitlint",
    "lint-staged": "lint-staged",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.11",
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "bun-types": "1.4.2",
    "commitlint": "21.2.2",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.4.1",
    "mockttp": "4.6.2",
    "neverthrow": "^8.2.0",
    "nock": "14.0.17",
    "prettier": "^3.9.6",
    "tsup": "8.5.1",
    "typescript": "^6",
    "typescript-eslint": "^8.69.0",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  }
}
