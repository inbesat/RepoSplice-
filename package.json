{
  "name": "repo-stitcher",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-repo composition engine with AI-augmented stitching.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:deps": "depcruise packages/core/src --config packages/core/dependency-cruiser.config.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "build": "echo \"build: deferred to P-062 (tsup per-package; build:core/cli/web aggregates)\" && exit 0",
    "build:core": "echo \"build:core: deferred to P-062 (tsup)\" && exit 0",
    "build:cli": "echo \"build:cli: deferred to P-062 (tsup)\" && exit 0",
    "build:web": "echo \"build:web: deferred to P-048 (vite build)\" && exit 0",
    "build:all": "bun run build:core && bun run build:cli && bun run build:web",
    "dev:cli": "echo \"dev:cli: deferred to P-189 (commander + bun --watch)\" && exit 0",
    "dev:web": "echo \"dev:web: deferred to P-208 (Vite scaffold)\" && exit 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "echo \"validate: deferred to AGENTS.md gate (per-phase)\" && exit 0",
    "prepare": "husky",
    "commitlint": "commitlint",
    "lint-staged": "lint-staged",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.11",
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "commitlint": "21.2.2",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^6",
    "typescript-eslint": "^8.69.0",
    "vitest": "5.0.0",
    "yaml": "2.9.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
