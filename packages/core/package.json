{
  "name": "@repo-stitcher/core",
  "version": "0.0.0",
  "private": true,
  "description": "Core business logic for repo-stitcher: git, github, deps, license, ai, sandbox, provenance, orchestration. Zero UI deps.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "echo \"build: deferred to P-062 (tsup)\" && exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "nanoid": "^6.0.1",
    "neverthrow": "^8.2.0",
    "picomatch": "^4.0.7",
    "pino": "^10.3.1",
    "semver": "^7.8.5",
    "simple-git": "^3.36.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "pino-pretty": "^13.1.3"
  }
}
