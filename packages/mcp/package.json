{
  "name": "@repo-stitcher/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server exposing the RepoSplice public core API to AI clients over stdio and HTTP.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "echo \"build: deferred to P-062 (tsup)\" && exit 0",
    "dev": "bun --watch src/index.ts",
    "server": "bun src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@repo-stitcher/core": "workspace:*",
    "elysia": "1.4.30"
  }
}
