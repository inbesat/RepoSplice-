# .env.example — copy to `.env` and fill in. NEVER commit the real `.env`.
#
# `stitch init` writes this file with NAMES ONLY; no value belongs in a
# scaffolded, committed file. Only the provider you actually use is required.

# Primary AI provider (see stitch.toml [openrouter]).
OPENROUTER_API_KEY=

# Alternative providers, if you switch in stitch.toml.
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

# GitHub access for creating repo C and opening the PR.
# A PAT with `repo` scope, or set `[github] authType` for an App instead.
GITHUB_TOKEN=
