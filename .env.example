# repo-stitcher — Environment Variables
# Copy to `.env` and fill in values. NEVER commit `.env`.
# All variables map to fields in packages/core/src/config/schema.ts.

# ─── GitHub auth (mutually exclusive authType: 'pat' or 'app') ────────────────
# For Personal Access Token auth:
GITHUB_TOKEN=ghp_replace_me

# For GitHub App auth (authType=app; requires all 3 below):
# GITHUB_AUTH_TYPE=app
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/key.pem
# GITHUB_APP_INSTALLATION_ID=123456

# ─── AI providers (loadConfig accepts any combination; precedence per schema) ──
# OpenRouter (used by default for AI operations):
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_DEFAULT_MODEL=openai/gpt-5

# Anthropic (alternative provider):
ANTHROPIC_API_KEY=sk-ant-replace-me

# Ollama (local models):
OLLAMA_BASE_URL=http://localhost:11434

# ─── Sandbox ──────────────────────────────────────────────────────────────────
# SANDBOX_BACKEND=docker                # 'docker' | 'github-actions'
# SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock
# SANDBOX_LIMITS_MEMORY=2g
# SANDBOX_LIMITS_CPU=1
# SANDBOX_LIMITS_TIMEOUT=600            # seconds

# ─── Paths ────────────────────────────────────────────────────────────────────
# REPO_STITCHER_CACHE_DIR=.repo-stitcher/cache
# REPO_STITCHER_WORKTREE_DIR=.repo-stitcher/worktrees
