{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pair_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed"]
    },
    "build_pass": {
      "type": ["boolean", "null"]
    },
    "build_logs": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "test_logs": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "human_score": {
      "anyOf": [
        {
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "human_scores": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "human_rater": {
      "type": ["string", "null"]
    },
    "rubric_score": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "null"
        }
      ]
    },
    "ecosystem": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["js", "python", "go", "rust"]
        },
        {
          "type": "null"
        }
      ]
    },
    "tokens_total": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_usd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "resolve_rate": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cost": {
      "type": "number",
      "minimum": 0
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "error_code": {
      "type": ["string", "null"]
    },
    "error_message": {
      "type": ["string", "null"]
    }
  },
  "required": [
    "pair_id",
    "status",
    "build_pass",
    "build_logs",
    "test_logs",
    "rubric_score",
    "resolve_rate",
    "tokens",
    "cost",
    "duration",
    "error_code",
    "error_message"
  ],
  "additionalProperties": {}
}
